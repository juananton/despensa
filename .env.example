# Copia este fichero a .env.local y rellena los dos valores con los de tu
# proyecto de Supabase.
#
#   VITE_SUPABASE_URL              -> Settings -> Data API -> Project URL
#   VITE_SUPABASE_PUBLISHABLE_KEY  -> Settings -> API Keys -> Publishable key
#                                     (empieza por sb_publishable_)
#
# La clave publishable es pública por diseño: viaja en el bundle del navegador y
# lo que protege los datos es la política RLS, no el secreto de la clave. Aun
# así .env.local está en .gitignore para no fijarla en el repo.
#
# La clave `sb_secret_` NO va aquí ni en ningún sitio del front: se salta todas
# las políticas RLS.

# Avisos push. El par de claves VAPID se genera una vez con:
#
#   npx web-push generate-vapid-keys
#
# La pública identifica a esta app ante el servicio de push del navegador y
# viaja en el bundle, como la publishable de arriba. La PRIVADA es la que firma
# los envíos: no va aquí, va en los secretos de la Edge Function (Supabase ->
# Edge Functions -> Secrets). Si se filtra, cualquiera puede enviaros avisos.
#
# Cambiar la clave pública invalida las suscripciones ya guardadas: habría que
# vaciar push_subscriptions y volver a activar los avisos en cada móvil.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_VAPID_PUBLIC_KEY=
